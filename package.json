    "@react-three/postprocessing": "^3.2.2",
    "@types/three": "^0.187.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.12.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "1.72.0",
    "maath": "^0.10.8",
    "postprocessing": "^6.39.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
